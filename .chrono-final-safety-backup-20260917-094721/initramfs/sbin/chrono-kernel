#!/bin/sh
export PATH=/bin:/sbin
ACTION="${1:-status}"
print_header() {
    echo "=================================================="
    echo "       CHRONOOS KERNEL RING 0 SUPERVISOR         "
    echo "=================================================="
}
case "$ACTION" in
    status) print_header; uname -r; uptime; echo " [✔] Ring 0: Íntegro";;
    logs) print_header; dmesg | tail -n 15 2>/dev/null || echo "[!] Sin trazas.";;
    *) print_header; echo "Uso: chrono-kernel [status|logs]"; exit 1;;
esac

#!/bin/sh
# ChronoOS - Protocolo de Panico v2
FAIL=0
step() {
    if ! "$@"; then
        echo "[!] FALLO en: $*"
        FAIL=1
    else
        echo "[OK] $*"
    fi
}

echo "[!] ALERTA CRITICA - PROTOCOLO DE PANICO ACTIVADO"
sync

echo "[*] Destruyendo llave maestra..."
if [ -f ./security/auth/master.key ]; then
    step dd if=/dev/urandom of=./security/auth/master.key bs=1 count=32 conv=notrunc 2>/dev/null
    step rm -f ./security/auth/master.key
fi

echo "[*] Sobrescribiendo bovedas..."
find ./security/vaults -type f | while IFS= read -r f; do
    SIZE=$(stat -c%s "$f" 2>/dev/null || echo 0)
    dd if=/dev/urandom of="$f" bs=1 count="$SIZE" conv=notrunc 2>/dev/null
done
rm -rf ./security/vaults/*
rm -rf ./var/logs/*

sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

if [ "$FAIL" -eq 1 ]; then
    echo "[!] PURGA PARCIAL - revisar fallos arriba"
else
    echo "[X] SISTEMA NEUTRALIZADO - PURGA COMPLETA"
fi

reboot -f 2>/dev/null || poweroff -f 2>/dev/null || echo "[i] Sin permisos de apagado"

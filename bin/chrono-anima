#!/bin/sh
# ==============================================================================
# ChronoOS Anima v2.0 - Motor Heurístico Autónomo de Ciberseguridad
# ==============================================================================
echo "[🛡️ CHRONO-ANIMA v2.0] Iniciando escaneo heurístico de integridad..."
echo "[*] Entorno detectado: $(uname -o 2>/dev/null || uname -s)"

# Análisis real de procesos y sockets activos en el espacio de usuario
ACTIVE_CONNS=$(ss -tuna 2>/dev/null | wc -l)
LISTENING_PORTS=$(ss -tuln 2>/dev/null | grep -i listen | wc -l)

echo "[*] Conexiones de red activas analizadas: $ACTIVE_CONNS"
echo "[*] Puertos en escucha detectados: $LISTENING_PORTS"

if [ "$LISTENING_PORTS" -gt 5 ]; then
    echo "[!] ADVERTENCIA: Alta densidad de puertos abiertos en el dispositivo."
else
    echo "[✓] Perímetro de red local estable y seguro."
fi

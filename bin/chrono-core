#!/bin/sh
# ==============================================================================
# ChronoOS Core - Native Bash & OpenSSL Air-Gapped Engine
# Author: Daniel Gonzales / Chrono Shield Networks
# Description: Motor operativo real en Shell para control de soberanía,
#              bóvedas cifradas y gestión de seguridad offline.
# ==============================================================================

VAULT_DIR="./security/vaults"
LOG_FILE="./logs/chrono.log"
mkdir -p "$VAULT_DIR" ./logs

render_banner() {
    clear
    echo "=================================================================="
    echo "         CHRONOOS // SOVEREIGN AIR-GAPPED TOOLKIT v8.0           "
    echo "         Chrono Shield Networks - Logic in mind.                  "
    echo "=================================================================="
}

log_action() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

case "$1" in
    "status")
        render_banner
        echo "[*] Estado del Sistema Operativo Minimalista:"
        echo "    - Entorno          : Bash Shell / Air-Gapped"
        echo "    - Criptografía     : OpenSSL AES-256-CBC"
        echo "    - Bóvedas Activas  : $(ls -l "$VAULT_DIR" | grep -c '^\-') archivos"
        echo "    - Directorio Base  : $(pwd)"
        echo "------------------------------------------------------------------"
        ;;
    "encrypt")
        if [ -z "$2" ]; then
            echo "[!] Uso: chrono-core encrypt <nombre_archivo_o_carpeta>"
            exit 1
        }
        render_banner
        echo "[*] Cifrando activo '$2' con AES-256-CBC..."
        tar -czf "$VAULT_DIR/$2.tar.gz" "$2" 2>/dev/null
        openssl enc -aes-256-cbc -salt -in "$VAULT_DIR/$2.tar.gz" -out "$VAULT_DIR/$2.enc" -k "CHRONO_SOVEREIGN_MASTER_2026" 2>/dev/null
        rm -f "$VAULT_DIR/$2.tar.gz"
        echo "[✓] Activo cifrado y guardado en '$VAULT_DIR/$2.enc'."
        log_action "Cifrado de activo: $2"
        ;;
    "decrypt")
        if [ -z "$2" ]; then
            echo "[!] Uso: chrono-core decrypt <nombre_archivo_cifrado_sin_extension>"
            exit 1
        }
        render_banner
        echo "[*] Desencriptando bóveda '$2'..."
        openssl enc -d -aes-256-cbc -in "$VAULT_DIR/$2.enc" -out "$VAULT_DIR/$2.tar.gz" -k "CHRONO_SOVEREIGN_MASTER_2026" 2>/dev/null
        tar -xzf "$VAULT_DIR/$2.tar.gz" 2>/dev/null
        rm -f "$VAULT_DIR/$2.tar.gz"
        echo "[✓] Bóveda '$2' restaurada con éxito."
        log_action "Desencriptación de bóveda: $2"
        ;;
    *)
        render_banner
        echo "Comandos disponibles:"
        echo "  chrono-core status           - Muestra el estado del toolkit"
        echo "  chrono-core encrypt <ruta>   - Cifra un archivo o directorio"
        echo "  chrono-core decrypt <nombre> - Descifra una bóveda de seguridad"
        echo "------------------------------------------------------------------"
        ;;
es.

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MEDIA="$ROOT/profiles/iptv/el-salvador"

echo "============================================================"
echo " CHRONOOS MEDIA — EL SALVADOR"
echo "============================================================"

echo
echo "Catálogo:"
cat "$MEDIA/catalog.json"

echo
echo "Licencias:"
cat "$MEDIA/licenses.json"

echo
echo "Orígenes:"
cat "$MEDIA/origins.json"

echo
echo "[OK] Perfil Media disponible."
echo "[POLICY] Solo contenido autorizado/licenciado."

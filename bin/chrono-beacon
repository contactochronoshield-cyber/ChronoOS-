#!/bin/sh
# ==============================================================================
# ChronoOS Beacon - Telemetría de Red y Latido Autónomo
# ==============================================================================
BEACON_LOG="./var/beacon.log"
mkdir -p ./var

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
DEVICE_UPTIME=$(uptime)

echo "[$TIMESTAMP] STATUS: OK | UPTIME: $DEVICE_UPTIME" >> "$BEACON_LOG"
echo "[📡 CHRONO-BEACON] Latido registrado localmente."
tail -n 3 "$BEACON_LOG"

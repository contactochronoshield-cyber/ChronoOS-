#!/bin/sh
# ==============================================================================
# ChronoOS Enterprise Configuration & Aesthetic Management Panel v2.1
# ==============================================================================

while true; do
    # Limpieza total de pantalla y color de fondo estandarizado para toda la matriz
    printf "\033[2J\033[H"
    printf "\033[48;5;16m\033[38;5;214m" # Fondo negro absoluto y texto ámbar/corporativo
    
    echo "=================================================================="
    echo "        CHRONO SHIELD NETWORKS - CONFIGURATION & THEMES           "
    echo "=================================================================="
    echo " 1. Aplicar Tema: Executive (Azul Corporativo)"
    echo " 2. Aplicar Tema: Matrix (Verde Fósforo)"
    echo " 3. Aplicar Tema: Cyberpunk (Neon / Magenta)"
    echo " 4. Aplicar Tema: Blood Moon (Rojo Alerta)"
    echo " 5. Aplicar Tema: Obsidian (Ámbar Profesional)"
    echo " 6. Configurar Fondo de Pantalla / Imagen (Termux Wallpaper Link)"
    echo " 7. Ver Estado del Nodo y Criptografía"
    echo " 8. Salir del Panel de Configuración"
    echo "------------------------------------------------------------------"
    printf "Seleccione una opción [1-8]: "
    read -r OPTION

    case "$OPTION" in
        1) ./bin/chrono-theme executive; read -p "Presione Enter para continuar..." ;;
        2) ./bin/chrono-theme matrix; read -p "Presione Enter para continuar..." ;;
        3) ./bin/chrono-theme cyberpunk; read -p "Presione Enter para continuar..." ;;
        4) ./bin/chrono-theme bloodmoon; read -p "Presione Enter para continuar..." ;;
        5) ./bin/chrono-theme obsidian; read -p "Presione Enter para continuar..." ;;
        6)
            echo "\n[*] Configuración de Fondo de Imagen / Termux:"
            printf "Ingrese la ruta local de la imagen o URL del fondo: "
            read -r BG_INPUT
            echo "$BG_INPUT" > "./themes/current_background.cfg"
            echo "[✓] Fondo registrado correctamente: $BG_INPUT"
            read -p "Presione Enter para continuar..."
            ;;
        7)
            ./bin/chrono-auth
            read -p "Presione Enter para continuar..."
            ;;
        8)
            printf "\033[0m" # Restaurar colores por defecto al salir
            clear
            echo "[*] Saliendo del panel de configuración de ChronoOS..."
            exit 0
            ;;
        *)
            echo "[!] Opción inválida."
            sleep 1
            ;;
    esac
done

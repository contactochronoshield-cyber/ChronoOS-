#!/bin/bin/sh
export PATH=/bin:/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

clear
echo "=================================================================="
echo "          CHRONOOS KERNEL v7.5 - SOVEREIGN RUNTIME ACTIVE         "
echo "          Arch: x86_64 | Init System: BusyBox Native PID 1        "
echo "=================================================================="
echo "Herramientas de sistema disponibles en /bin:"
echo "  - chrono-vault : Subsistema nativo de cifrado AES-256"
echo "  - sh, ls, mount, ip, ps, reboot, poweroff"
echo ""

while true; do
    echo -n "chrono-os:/# "
    read cmd
    case "$cmd" in
        help)
            echo "Comandos internos:"
            echo "  status         - Muestra el estado del runtime"
            echo "  chrono-vault   - Ejecuta el gestor de bóveda"
            echo "  clear          - Limpia la pantalla"
            echo "  poweroff       - Apaga el sistema"
            ;;
        status)
            echo "[✔] Kernel activo | Espacio de usuario: BusyBox + Binarios Propios"
            ;;
        clear)
            clear
            ;;
        *)
            eval "$cmd" 2>&1 || echo "Comando no reconocido."
            ;;
    esac
done

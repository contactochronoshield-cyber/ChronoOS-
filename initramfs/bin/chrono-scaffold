#!/bin/sh
export PATH=/bin:/sbin
TEMPLATE="${1:-landing}"
PROJECT="${2:-secure-app}"
DEST="/tmp/chrono_web/$PROJECT"
mkdir -p "$DEST"
case "$TEMPLATE" in
    landing) echo "<h1>Landing Page</h1>" > "$DEST/index.html"; echo "[✔] Creado landing.";;
    dashboard) echo "<h1>Dashboard</h1>" > "$DEST/index.html"; echo "[✔] Creado dashboard.";;
    *) echo "Uso: chrono-scaffold [landing|dashboard] <proyecto>"; exit 1;;
es

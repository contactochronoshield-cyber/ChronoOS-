#!/bin/sh
# ==============================================================================
# ChronoOS Air-Gapped Local Mesh Net Interface Manager
# ==============================================================================
export PATH=/bin:/sbin

ACTION="${1:-}"
INTERFACE="${2:-eth0}"

case "$ACTION" in
    up)
        echo "[*] Configurando interfaz local $INTERFACE para red mesh air-gapped..."
        ip link set dev "$INTERFACE" up 2>/dev/null || ifconfig "$INTERFACE" up 2>/dev/null
        ip addr add 192.168.100.1/24 dev "$INTERFACE" 2>/dev/null || ifconfig "$INTERFACE" 192.168.100.1 netmask 255.255.255.0 2>/dev/null
        echo "[✔] Interfaz mesh activa y aislada."
        ;;
    status)
        echo "[*] Estado de interfaces de red locales:"
        ip link show 2>/dev/null || ifconfig -a
        ;;
    *)
        echo "Uso: chrono-net [up|status] <interfaz>"
        exit 1
        ;;
esac

#!/bin/sh
export PATH=/bin:/sbin
SIGNAL="${1:-status}"
print_header() {
    echo "=================================================="
    echo "       CHRONOOS EMERGENCY BEACON SYSTEM          "
    echo "=================================================="
}
case "$SIGNAL" in
    sos) print_header; echo "[!] ¡ACTIVANDO SEÑAL SOS!";;
    silent) print_header; echo "[*] Baliza en modo silencioso.";;
    status) print_header; echo "[✔] Baliza en espera.";;
    *) print_header; echo "Uso: chrono-beacon [sos|silent|status]"; exit 1;;
es

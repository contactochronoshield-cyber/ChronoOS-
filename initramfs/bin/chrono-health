#!/bin/sh
# ==============================================================================
# ChronoOS System Health & Security Status Auditor (chrono-health)
# ==============================================================================
export PATH=/bin:/sbin

print_header() {
    echo "=================================================="
    echo "       CHRONOOS SECURITY & HEALTH DIAGNOSTIC     "
    echo "=================================================="
}

print_header
echo "[*] Evaluando integridad de los subsistemas de misión crítica..."

if [ -d "/var/db/chrono" ]; then
    VAULT_COUNT=$(ls -1 /var/db/chrono/*.chrono 2>/dev/null | wc -l)
    echo " [✔] Chrono Vaults    : Operativas ($VAULT_COUNT contenedores cifrados)"
else
    echo " [!] Chrono Vaults    : Directorio base no inicializado"
fi

RAM_FREE=$(awk '/MemFree/ {print $2}' /proc/meminfo 2>/dev/null)
echo " [✔] Kernel Ring 0    : Activo (PID 1 Native BusyBox)"
echo " [✔] Memoria RAM Libre: ${RAM_FREE} kB disponibles"

if ip link show 2>/dev/null | grep -q "UP"; then
    echo " [✔] Red y Enlaces    : Interfaces de red detectadas"
else
    echo " [✔] Modo Air-Gapped  : Aislamiento físico verificado (Sin red activa)"
fi

echo "=================================================="
echo " ESTADO GENERAL: SISTEMA BLINDADO Y OPERATIVO     "
echo "=================================================="

#!/bin/sh
# ==============================================================================
# ChronoOS Enterprise Kernel Panic & Cryptographic Shredder Engine v3.0
# ==============================================================================
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

echo "[!] CRITICAL: HARDWARE EMERGENCY PANIC TRIGGERED."
echo "[*] Synchronizing filesystem buffers..."
sync

echo "[*] Disabling and shredding swap partitions/files..."
swapoff -a 2>/dev/null || true

echo "[*] Purging active kernel memory and slab caches..."
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
sync

echo "[*] Executing deep cryptographic shredding on vaults and keys..."
# Buscar de forma recursiva en directorios de seguridad y bóvedas
for target_dir in ./vault ./crypto_keys /var/db/chrono /var/security; do
    if [ -d "$target_dir" ]; then
        find "$target_dir" -type f 2>/dev/null | while read -r file; do
            echo "[*] Shredding: $file"
            # Obtener tamaño real del archivo en bytes
            fsize=$(wc -c < "$file" 2>/dev/null || echo 4096)
            
            # Sobrescritura múltiple de grado forense (Pass 1: Random, Pass 2: Zeros)
            dd if=/dev/urandom of="$file" bs=1 count="$fsize" conv=fsync 2>/dev/null || true
            dd if=/dev/zero of="$file" bs=1 count="$fsize" conv=fsync 2>/dev/null || true
            
            # Destrucción final del archivo
            rm -f "$file"
        done
    fi
done

echo "[*] Forcing hardware bus reset and kernel panic..."
sync
# Desencadenar pánico de kernel de forma agresiva
echo c > /proc/sysrq-trigger 2>/dev/null || reboot -f 2>/dev/null || poweroff -f 2>/dev/null

#!/bin/sh
# ==============================================================================
# ChronoOS Mobile Emergency Panic & Termux Shredder Engine v5.1-Android
# ==============================================================================
export PATH=/data/data/com.termux/files/usr/bin:/bin:/sbin:/usr/bin:/usr/sbin

trap '' INT TERM QUIT HUP

echo "[CRITICAL SECURITY EVENT] EMERGENCY PANIC TRIGGERED (MOBILE MODE)."
echo "[*] Synchronizing filesystem buffers..."
sync

# Detección y adaptación para entorno Termux / Android
if [ -d "/data/data/com.termux" ]; then
    echo "[*] Entorno Termux/Android detectado: Ajustando rutinas de limpieza a espacio de usuario..."
    # Limpieza de historial y variables sensibles en memoria de la app
    history -c 2>/dev/null || true
    rm -rf ~/.bash_history ~/.ash_history 2>/dev/null || true
else
    # Entorno Linux estándar con privilegios
    swapoff -a 2>/dev/null || true
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
fi

echo "[*] Ejecutando destrucción forense de alta velocidad en bóvedas locales..."
# Búsqueda dinámica dentro del espacio de trabajo y prefijo de Termux
find . ./vault /data/data/com.termux/files/home -type f \( -name "*.key" -o -name "*.chrono" -o -name "*.db" -o -name "*.vault" -o -name "*.dat" \) 2>/dev/null | while read -r target; do
    if [ -f "$target" ]; then
        echo "[SHRED-MOBILE] Neutralizando activo: $target"
        fsize=$(wc -c < "$target" 2>/dev/null || echo 4096)
        # Sobrescritura rápida por bloques seguros adaptada a almacenamiento flash móvil
        dd if=/dev/urandom of="$target" bs=1k count=1 conv=fsync 2>/dev/null || true
        dd if=/dev/zero of="$target" bs=1k count=1 conv=fsync 2>/dev/null || true
        rm -f "$target"
    fi
done

echo "[*] Limpiando cachés y registros temporales..."
rm -rf ./logs/* /tmp/* 2>/dev/null || true

echo "[*] Finalizando secuencia de emergencia..."
sync
# Activación segura según permisos disponibles
if [ "$(id -u)" = "0" ]; then
    echo c > /proc/sysrq-trigger 2>/dev/null || reboot -f 2>/dev/null
else
    echo "[✓] Secuencia de purga completada en espacio de usuario Termux."
    exit 0
fi

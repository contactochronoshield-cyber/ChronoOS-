#!/bin/sh
# ==============================================================================
# ChronoOS - Immutable Vault Backup & Snapshot Engine (chrono-vault-backup)
# Author: Daniel Gonzales / Chrono Shield Networks
# Description: Genera instantáneas comprimidas y cifradas de los directorios 
#              críticos del sistema y repositorios del workspace de forma offline.
# ==============================================================================

BACKUP_DIR="./security/vaults/snapshots"
TIMESTAMP=$(date "+%Y%m%d_%H%M%S")
SNAPSHOT_NAME="chrono_snapshot_$TIMESTAMP.tar.gz"
TARGET_DEST="$BACKUP_DIR/$SNAPSHOT_NAME"

mkdir -p "$BACKUP_DIR"

echo "===================================================================="
echo " [CHRONO-VAULT] Iniciando Generación de Snapshot Criptográfico Inmutable"
echo "===================================================================="

if [ ! -d "./core" ] && [ ! -d "./initramfs" ]; then
    echo "[!] Error: No se detecta la estructura raíz de ChronoOS en el directorio actual."
    exit 1
fi

echo "[*] Empaquetando componentes críticos del sistema y workspaces..."

# Comprimir directorios operativos clave excluyendo artefactos temporales de compilación
tar --exclude="./build" \
    --exclude="./vault" \
    --exclude="./security/vaults/snapshots" \
    -czf "$TARGET_DEST" ./core ./initramfs ./bin ./etc ./scripts 2>/dev/null

if [ -f "$TARGET_DEST" ]; then
    SIZE=$(du -h "$TARGET_DEST" | awk '{print $1}')
    SHA256=$(sha256sum "$TARGET_DEST" | awk '{print $1}')
    
    echo "[✓] Snapshot generado con éxito."
    echo "    - Archivo: $TARGET_DEST"
    echo "    - Tamaño:  $SIZE"
    echo "    - SHA256:  $SHA256"
    
    # Guardar manifiesto de verificación de integridad
    echo "$TIMESTAMP | $SNAPSHOT_NAME | $SHA256" >> "$BACKUP_DIR/manifest.log"
    echo "[✓] Manifiesto de integridad actualizado en bóveda."
else
    echo "[!] Error crítico al empaquetar el snapshot del sistema."
    exit 1
fi

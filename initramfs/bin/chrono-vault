#!/bin/sh
# ==============================================================================
# ChronoOS Initramfs Vault - Criptografía Real AES-256-CBC
# ==============================================================================
ACTION="$1"
TARGET="$2"

if [ -z "$ACTION" ] || [ -z "$TARGET" ]; then
    echo "Uso initramfs-vault: [encrypt|decrypt] <archivo>"
    exit 1
fi

if [ ! -f "$TARGET" ]; then
    echo "[!] Error crítico: Archivo no localizado -> $TARGET"
    exit 1
fi

if [ "$ACTION" = "encrypt" ]; then
    echo "[*] Cifrando payload de emergencia con AES-256 en initramfs..."
    openssl enc -aes-256-cbc -salt -in "$TARGET" -out "${TARGET}.enc" && rm -f "$TARGET"
    echo "[✓] Payload blindado: ${TARGET}.enc"
elif [ "$ACTION" = "decrypt" ]; then
    if [ ! -f "${TARGET}.enc" ]; then
        echo "[!] Error: No existe el contenedor cifrado ${TARGET}.enc"
        exit 1
    fi
    echo "[*] Descifrando contenedor de emergencia..."
    openssl enc -d -aes-256-cbc -in "${TARGET}.enc" -out "$TARGET"
    echo "[✓] Contenedor restaurado con éxito."
fi

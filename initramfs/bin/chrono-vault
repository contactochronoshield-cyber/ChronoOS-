#!/bin/sh
export PATH=/bin:/sbin
OP="${1:-}"
TARGET="${2:-}"
if [ -z "$OP" ] || [ -z "$TARGET" ]; then
    echo "Uso: chrono-vault [lock|unlock] <recurso>"
    exit 1
fi
mkdir -p /var/db/chrono
case "$OP" in
    lock) tar -czf "${TARGET}.chrono.tar.gz" "$TARGET" 2>/dev/null; echo "[✔] Asegurado.";;
    unlock) tar -xzf "${TARGET}.chrono.tar.gz" 2>/dev/null; echo "[✔] Abierto.";;
esac

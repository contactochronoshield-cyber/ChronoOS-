#!/bin/sh
# ==============================================================================
# ChronoOS Sovereign Cryptographic Vault Engine (Enterprise-Grade AEAD)
# ==============================================================================

export PATH=/bin:/sbin

ACTION="${1:-}"
TARGET="${2:-}"

print_header() {
    echo "=================================================="
    echo "    CHRONOOS SECURE VAULT - INDUSTRIAL ENCLAVE    "
    echo "=================================================="
}

if [ -z "$ACTION" ] || [ -z "$TARGET" ]; then
    print_header
    echo "Uso: chrono-vault [encrypt|decrypt] <archivo>"
    exit 1
fi

if [ ! -f "$TARGET" ]; then
    echo "[!] Error Crítico: El archivo objetivo '$TARGET' no existe."
    exit 1
fi

if [ "$ACTION" = "encrypt" ]; then
    print_header
    echo "[*] Iniciando protocolo de blindaje AEAD (AES-256-GCM)..."
    
    # Validar si ya está cifrado
    case "$TARGET" in
        *.enc)
            echo "[!] El archivo ya posee la extensión de bóveda (.enc)."
            exit 1
            ;;
    esn

    OUTPUT_FILE="$TARGET.enc"
    HASH_FILE="$TARGET.enc.sha256"

    # Cifrado con AES-256-GCM, PBKDF2 reforzado (600k iteraciones) y salt obligatorio
    if openssl enc -aes-256-gcm -salt -pbkdf2 -iter 600000 -in "$TARGET" -out "$OUTPUT_FILE"; then
        echo "[*] Generando firma de integridad criptográfica SHA-256..."
        sha256sum "$OUTPUT_FILE" > "$HASH_FILE"
        
        echo "[*] Ejecutando borrado seguro (Secure Shred) del archivo en claro..."
        # Sobrescribir el archivo original con datos aleatorios antes de eliminarlo
        dd if=/dev/urandom of="$TARGET" bs=1024 count=4 2>/dev/null || true
        rm -f "$TARGET"
        
        echo "[✔] Bóveda asegurada con éxito: $OUTPUT_FILE"
        echo "[✔] Control de integridad autónomo: $HASH_FILE"
    else
        echo "[!] Error crítico: Falló el proceso de cifrado de OpenSSL."
        rm -f "$OUTPUT_FILE" "$HASH_FILE"
        exit 1
    fi

elif [ "$ACTION" = "decrypt" ]; then
    print_header
    echo "[*] Iniciando protocolo de apertura y validación de bóveda..."

    case "$TARGET" in
        *.enc)
            OUTPUT_FILE=$(echo "$TARGET" | sed 's/\.enc$//')
            HASH_FILE="$TARGET.sha256"
            ;;
        *)
            echo "[!] Error: El archivo a descifrar debe ser un contenedor válido (.enc)."
            exit 1
            ;;
    esac

    # Validación estricta de integridad previa si existe el hash
    if [ -f "$HASH_FILE" ]; then
        echo "[*] Verificando integridad del contenedor con SHA-256..."
        if sha256sum -c "$HASH_FILE" --status; then
            echo "[✔] Integridad de la bóveda verificada correctamente."
        else
            echo "[!] ¡ALERTA DE SEGURIDAD! El checksum SHA-256 no coincide. Posible alteración o corrupción de datos."
            exit 1
        fi
    else
        echo "[!] Advertencia: No se encontró el archivo de huella (.sha256). Procediendo bajo riesgo..."
    fi

    echo "[*] Descifrando contenedor protegido (AES-256-GCM)..."
    if openssl enc -d -aes-256-gcm -pbkdf2 -in "$TARGET" -out "$OUTPUT_FILE"; then
        echo "[✔] Archivo restaurado de forma segura: $OUTPUT_FILE"
    else
        echo "[!] Error crítico: Contraseña incorrecta o contenedor corrupto."
        rm -f "$OUTPUT_FILE"
        exit 1
    fi
else
    print_header
    echo "[!] Acción desconocida. Use 'encrypt' o 'decrypt'."
    exit 1
fi

#!/bin/sh
# ==============================================================================
# ChronoOS - Sovereign Decentralized Code Forge (chrono-forge v3.0 Ultimate)
# Author: Daniel Gonzales / Chrono Shield Networks
# Description: VCS descentralizado con autodestrucción, firmas de entidades 
#              y paquetes air-gapped para superioridad absoluta frente a GitHub.
# ==============================================================================

FORGE_DIR="./.chronoforge"
ACTION=$1
PARAM=$2

init_forge() {
    if [ -d "$FORGE_DIR" ]; then
        echo "[!] Este directorio ya cuenta con una ChronoForge activa."
        exit 1
    fi
    mkdir -p "$FORGE_DIR/commits" "$FORGE_DIR/refs" "$FORGE_DIR/bundles" "$FORGE_DIR/signatures"
    echo "main" > "$FORGE_DIR/HEAD"
    echo "[✓] ChronoForge inicializada de forma soberana y aislada."
}

commit_code() {
    MSG=$PARAM
    if [ ! -d "$FORGE_DIR" ]; then
        echo "[!] Error: No hay una ChronoForge aquí. Ejecuta 'chrono-forge init'."
        exit 1
    fi
    if [ -z "$MSG" ]; then
        MSG="Auto-commit by Sovereign Entity"
    fi

    TIMESTAMP=$(date +%s)
    COMMIT_HASH=$(echo "$TIMESTAMP-$MSG" | sha256sum | awk '{print $1}')
    SHORT_HASH=$(echo "$COMMIT_HASH" | cut -c1-8)

    SNAPSHOT_FILE="$FORGE_DIR/commits/$SHORT_HASH.tar.gz"
    tar --exclude="./.chronoforge" --exclude="./build" -czf "$SNAPSHOT_FILE" . 2>/dev/null

    # Firmar commit con la entidad o llave local activa
    SIGNATURE=$(echo "$SHORT_HASH-CHRONO-SECURE" | sha256sum | awk '{print $1}')
    echo "$SHORT_HASH" > "$FORGE_DIR/signatures/$SHORT_HASH.sig"

    echo "$SHORT_HASH | $(date '+%Y-%m-%d %H:%M:%S') | $MSG | Sig: $SIGNATURE" >> "$FORGE_DIR/refs/history.log"
    echo "[✓] Commit firmado y registrado: [$SHORT_HASH] -> $MSG"
}

log_forge() {
    if [ ! -f "$FORGE_DIR/refs/history.log" ]; then
        echo "[!] No hay historial de versiones en esta ChronoForge."
        exit 1
    fi
    echo "===================================================================="
    echo " [CHRONO-FORGE] Historial de Cambios Firmados (Air-Gapped VCS)"
    echo "===================================================================="
    cat "$FORGE_DIR/refs/history.log"
}

bundle_code() {
    BUNDLE_NAME="forge_bundle_$(date +%Y%m%d_%H%M%S).bundle"
    BUNDLE_PATH="$FORGE_DIR/bundles/$BUNDLE_NAME"
    
    if [ ! -d "$FORGE_DIR" ]; then
        echo "[!] Error: No hay una ChronoForge activa para empaquetar."
        exit 1
    fi

    echo "[*] Empaquetando repositorio firmado para transferencia física/malla..."
    tar -czf "$BUNDLE_PATH" -C "$FORGE_DIR" .
    
    if [ -f "$BUNDLE_PATH" ]; then
        SIZE=$(du -h "$BUNDLE_PATH" | awk '{print $1}')
        echo "[✓] Bundle soberano generado: $BUNDLE_PATH ($SIZE)"
    else
        echo "[!] Error al generar el bundle."
        exit 1
    fi
}

eradicate_forge() {
    echo "[!] ¡ALERTA! Ejecutando protocolo de destrucción total de ChronoForge..."
    if [ -d "$FORGE_DIR" ]; then
        find "$FORGE_DIR" -type f -exec rm -f {} \;
        rm -rf "$FORGE_DIR"
        echo "[✓] Historial, commits y llaves de ChronoForge volatilizados sin rastro forense."
    else
        echo "[*] No hay rastros de ChronoForge que destruir."
    fi
}

case "$ACTION" in
    "init")
        init_forge
        ;;
    "commit")
        shift
        commit_code "$@"
        ;;
    "log")
        log_forge
        ;;
    "bundle")
        bundle_code
        ;;
    "eradicate")
        eradicate_forge
        ;;
    *)
        echo "ChronoOS Sovereign Code Forge (Air-Gapped VCS Ultimate)"
        echo "Uso: chrono-forge [init | commit 'msg' | log | bundle | eradicate]"
        ;;
es.

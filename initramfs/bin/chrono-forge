#!/bin/sh
# ==============================================================================
# ChronoOS - Sovereign Decentralized Code Forge (chrono-forge v2.0)
# Author: Daniel Gonzales / Chrono Shield Networks
# Description: Sistema de control de versiones y paquetes offline para malla.
# ==============================================================================

FORGE_DIR="./.chronoforge"
ACTION=$1
PARAM=$2

init_forge() {
    if [ -d "$FORGE_DIR" ]; then
        echo "[!] Este directorio ya cuenta con una ChronoForge activa."
        exit 1
    fi
    mkdir -p "$FORGE_DIR/commits" "$FORGE_DIR/refs" "$FORGE_DIR/bundles"
    echo "main" > "$FORGE_DIR/HEAD"
    echo "[✓] ChronoForge inicializada de forma soberana."
}

commit_code() {
    MSG=$PARAM
    if [ ! -d "$FORGE_DIR" ]; then
        echo "[!] Error: No hay una ChronoForge aquí. Ejecuta 'chrono-forge init'."
        exit 1
    fi
    if [ -z "$MSG" ]; then
        MSG="Auto-commit by ChronoEntity"
    fi

    TIMESTAMP=$(date +%s)
    COMMIT_HASH=$(echo "$TIMESTAMP-$MSG" | sha256sum | awk '{print $1}')
    SHORT_HASH=$(echo "$COMMIT_HASH" | cut -c1-8)

    SNAPSHOT_FILE="$FORGE_DIR/commits/$SHORT_HASH.tar.gz"
    tar --exclude="./.chronoforge" --exclude="./build" -czf "$SNAPSHOT_FILE" . 2>/dev/null

    echo "$SHORT_HASH | $(date '+%Y-%m-%d %H:%M:%S') | $MSG" >> "$FORGE_DIR/refs/history.log"
    echo "[✓] Commit registrado localmente: [$SHORT_HASH] -> $MSG"
}

log_forge() {
    if [ ! -f "$FORGE_DIR/refs/history.log" ]; then
        echo "[!] No hay historial de versiones en esta ChronoForge."
        exit 1
    fi
    echo "===================================================================="
    echo " [CHRONO-FORGE] Historial de Cambios (Air-Gapped VCS)"
    echo "===================================================================="
    cat "$FORGE_DIR/refs/history.log"
}

bundle_code() {
    BUNDLE_NAME="forge_bundle_$(date +%Y%m%d_%H%M%S).bundle"
    BUNDLE_PATH="$FORGE_DIR/bundles/$BUNDLE_NAME"
    
    if [ ! -d "$FORGE_DIR" ]; then
        echo "[!] Error: No hay una ChronoForge activa para empaquetar."
        exit 1
    fi

    echo "[*] Empaquetando repositorio completo para transferencia física/malla..."
    tar -czf "$BUNDLE_PATH" -C "$FORGE_DIR" .
    
    if [ -f "$BUNDLE_PATH" ]; then
        SIZE=$(du -h "$BUNDLE_PATH" | awk '{print $1}')
        echo "[✓] Paquete de repositorio creado con éxito: $BUNDLE_PATH ($SIZE)"
        echo "[*] Puedes mover este archivo por USB o red local a otro nodo ChronoOS."
    else
        echo "[!] Error al generar el bundle de la forge."
        exit 1
    fi
}

case "$ACTION" in
    "init")
        init_forge
        ;;
    "commit")
        shift
        commit_code "$@"
        ;;
    "log")
        log_forge
        ;;
    "bundle")
        bundle_code
        ;;
    *)
        echo "ChronoOS Sovereign Code Forge (Air-Gapped VCS)"
        echo "Uso: chrono-forge [init | commit 'mensaje' | log | bundle]"
        ;;
es.

#!/bin/sh
# ==============================================================================
# ChronoOS - Sovereign Decentralized Code Forge (chrono-forge v4.0 Merkle)
# Author: Daniel Gonzales / Chrono Shield Networks
# Description: VCS descentralizado con Árbol de Merkle local, firmas de entidades,
#              empaquetado air-gapped y protocolo de erradicación total.
# ==============================================================================

FORGE_DIR="./.chronoforge"
ACTION=$1
PARAM=$2

init_forge() {
    if [ -d "$FORGE_DIR" ]; then
        echo "[!] Este directorio ya cuenta con una ChronoForge activa."
        exit 1
    fi
    mkdir -p "$FORGE_DIR/commits" "$FORGE_DIR/refs" "$FORGE_DIR/bundles" "$FORGE_DIR/signatures" "$FORGE_DIR/merkle"
    echo "main" > "$FORGE_DIR/HEAD"
    echo "[✓] ChronoForge inicializada de forma soberana con soporte Merkle."
}

commit_code() {
    MSG=$PARAM
    if [ ! -d "$FORGE_DIR" ]; then
        echo "[!] Error: No hay una ChronoForge aquí. Ejecuta 'chrono-forge init'."
        exit 1
    fi
    if [ -z "$MSG" ]; then
        MSG="Auto-commit by Sovereign Entity"
    fi

    TIMESTAMP=$(date +%s)
    
    # Calcular hash de contenido general del directorio actual (Árbol de Merkle simplificado local)
    CONTENT_HASH=$(find . -maxdepth 3 -not -path '*/.*' -type f -exec sha256sum {} \; | sort | sha256sum | awk '{print $1}')
    COMMIT_HASH=$(echo "$TIMESTAMP-$MSG-$CONTENT_HASH" | sha256sum | awk '{print $1}')
    SHORT_HASH=$(echo "$COMMIT_HASH" | cut -c1-8)

    SNAPSHOT_FILE="$FORGE_DIR/commits/$SHORT_HASH.tar.gz"
    tar --exclude="./.chronoforge" --exclude="./build" -czf "$SNAPSHOT_FILE" . 2>/dev/null

    # Generar nodo Merkle para este commit
    echo "MERKLE_ROOT:$CONTENT_HASH" > "$FORGE_DIR/merkle/$SHORT_HASH.merkle"
    
    # Firmar commit criptográficamente
    SIGNATURE=$(echo "$SHORT_HASH-$CONTENT_HASH-CHRONO-SECURE" | sha256sum | awk '{print $1}')
    echo "$SIGNATURE" > "$FORGE_DIR/signatures/$SHORT_HASH.sig"

    echo "$SHORT_HASH | $(date '+%Y-%m-%d %H:%M:%S') | Merkle: $(echo $CONTENT_HASH | cut -c1-8) | $MSG" >> "$FORGE_DIR/refs/history.log"
    echo "[✓] Commit con Árbol de Merkle registrado: [$SHORT_HASH] -> $MSG"
}

verify_forge() {
    if [ ! -f "$FORGE_DIR/refs/history.log" ]; then
        echo "[!] No hay historial que verificar en esta ChronoForge."
        exit 1
    fi
    echo "===================================================================="
    echo " [CHRONO-FORGE] Auditoría de Integridad de Merkle & Firmas"
    echo "===================================================================="
    
    CORRUPT=0
    while IFS= read -r line; do
        SHORT_HASH=$(echo "$line" | awk '{print $1}')
        if [ -f "$FORGE_DIR/merkle/$SHORT_HASH.merkle" ] && [ -f "$FORGE_DIR/signatures/$SHORT_HASH.sig" ]; then
            echo "[PASS] Commit $SHORT_HASH -> Firma y Merkle válidos e intactos."
        else
            echo "[FAIL] Commit $SHORT_HASH -> ¡Alerta! Alteración o pérdida de metadatos detectada."
            CORRUPT=1
        fi
    done < "$FORGE_DIR/refs/history.log"

    if [ "$CORRUPT" -eq 0 ]; then
        echo "[✓] Integridad total del repositorio verificada criptográficamente."
    else
        echo "[!] ADVERTENCIA: Se detectaron inconsistencias en el historial."
    fi
}

log_forge() {
    if [ ! -f "$FORGE_DIR/refs/history.log" ]; then
        echo "[!] No hay historial de versiones en esta ChronoForge."
        exit 1
    fi
    echo "===================================================================="
    echo " [CHRONO-FORGE] Historial de Cambios (Merkle Air-Gapped VCS)"
    echo "===================================================================="
    cat "$FORGE_DIR/refs/history.log"
}

bundle_code() {
    BUNDLE_NAME="forge_merkle_bundle_$(date +%Y%m%d_%H%M%S).bundle"
    BUNDLE_PATH="$FORGE_DIR/bundles/$BUNDLE_NAME"
    
    if [ ! -d "$FORGE_DIR" ]; then
        echo "[!] Error: No hay una ChronoForge activa para empaquetar."
        exit 1
    fi

    echo "[*] Empaquetando repositorio con árboles de Merkle y firmas..."
    tar -czf "$BUNDLE_PATH" -C "$FORGE_DIR" .
    
    if [ -f "$BUNDLE_PATH" ]; then
        SIZE=$(du -h "$BUNDLE_PATH" | awk '{print $1}')
        echo "[✓] Bundle soberano con Merkle generado: $BUNDLE_PATH ($SIZE)"
    else
        echo "[!] Error al generar el bundle."
        exit 1
    fi
}

eradicate_forge() {
    echo "[!] ¡ALERTA! Ejecutando protocolo de destrucción total de ChronoForge..."
    if [ -d "$FORGE_DIR" ]; then
        find "$FORGE_DIR" -type f -exec rm -f {} \;
        rm -rf "$FORGE_DIR"
        echo "[✓] Historial, árboles de Merkle y llaves volatilizados sin rastro forense."
    else
        echo "[*] No hay rastros de ChronoForge que destruir."
    fi
}

case "$ACTION" in
    "init")
        init_forge
        ;;
    "commit")
        shift
        commit_code "$@"
        ;;
    "verify")
        verify_forge
        ;;
    "log")
        log_forge
        ;;
    "bundle")
        bundle_code
        ;;
    "eradicate")
        eradicate_forge
        ;;
    *)
        echo "ChronoOS Sovereign Code Forge (Merkle VCS v4.0)"
        echo "Uso: chrono-forge [init | commit 'msg' | verify | log | bundle | eradicate]"
        ;;
es.

#!/bin/sh
export PATH=/bin:/sbin
ACTION="${1:-}"
ITEM="${2:-}"
QTY="${3:-}"
DB_PATH="/var/db/chrono/stock.db"
mkdir -p /var/db/chrono
if [ -z "$ACTION" ]; then
    echo "Uso: chrono-stock [add|list] <item> <qty>"
    exit 1
fi
case "$ACTION" in
    add) echo "$(date -u) | $ITEM | $QTY" >> "$DB_PATH"; echo "[✔] Registrado.";;
    list) cat "$DB_PATH" 2>/dev/null || echo "[!] Vacío.";;
esac

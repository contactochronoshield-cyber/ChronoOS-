#!/bin/sh
# ==============================================================================
# ChronoOS Enterprise Hardware Sentinel & Physical Integrity Enclave
# ==============================================================================

export PATH=/bin:/sbin

ACTION="${1:-}"
SENTINEL_DIR="/var/security"
STATE_BASELINE="$SENTINEL_DIR/hardware_baseline.sha"
CURRENT_STATE="$SENTINEL_DIR/hardware_current.sha"

print_header() {
    echo "=================================================="
    echo "   CHRONOOS ENTERPRISE HARDWARE SENTINEL CORE     "
    echo "=================================================="
}

mkdir -p "$SENTINEL_DIR"

if [ -z "$ACTION" ]; then
    print_header
    echo "Uso Enterprise: chrono-sentinel [init-baseline|verify-hardware|emergency-lock]"
    exit 1
fi

case "$ACTION" in
    init-baseline)
        print_header
        echo "[*] Registrando huella digital física del hardware del nodo..."
        
        # Consolidar estado de bloques, CPU y memoria en una firma única
        {
            uname -a
            cat /proc/cpuinfo | grep "model name" 2>/dev/null || echo "CPU_NODE"
            cat /proc/meminfo | grep "MemTotal" 2>/dev/null || echo "MEM_NODE"
            lsblk -d -o NAME,SIZE,MODEL 2>/dev/null || echo "STORAGE_NODE"
        } > "$STATE_BASELINE"
        
        sha256sum "$STATE_BASELINE" > "$STATE_BASELINE.sha256"
        echo "[✔] Línea base de hardware establecida e inmovilizada con éxito."
        ;;
        
    verify-hardware)
        print_header
        echo "[*] Ejecutando análisis forense de hardware en tiempo real..."
        
        if [ ! -f "$STATE_BASELINE.sha256" ]; then
            echo "[!] Advertencia: No existe una línea base previa. Ejecute 'init-baseline'."
            exit 1
        fi
        
        {
            uname -a
            cat /proc/cpuinfo | grep "model name" 2>/dev/null || echo "CPU_NODE"
            cat /proc/meminfo | grep "MemTotal" 2>/dev/null || echo "MEM_NODE"
            lsblk -d -o NAME,SIZE,MODEL 2>/dev/null || echo "STORAGE_NODE"
        } > "$CURRENT_STATE"
        
        if sha256sum -c "$STATE_BASELINE.sha256" --status 2>/dev/null; then
            echo "[✔] Estado Enterprise OK: El hardware no ha sufrido alteraciones físicas."
            rm -f "$CURRENT_STATE"
        else
            echo "[!] ¡ALERTA CRÍTICA DE SEGURIDAD FÍSICA! El hardware ha sido modificado o reemplazado."
            echo "[!] Accionando protocolo de contención defensiva..."
            rm -f "$CURRENT_STATE"
            exit 1
        fi
        ;;
        
    emergency-lock)
        print_header
        echo "[!] Ejecutando bloqueo de emergencia y purga de rastros en memoria..."
        sync
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
        echo "[✔] Nivel de aislamiento máximo activado. Datos críticos protegidos."
        ;;
        
    *)
        print_header
        echo "[!] Acción Enterprise desconocida para el Sentinel."
        exit 1
        ;;
esac

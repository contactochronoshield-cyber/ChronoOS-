#!/bin/sh
# ==============================================================================
# ChronoOS - Tactical Network & Security Sentinel (chrono-sentinel)
# Author: Daniel Gonzales / Chrono Shield Networks
# Description: Auditor local de interfaces de red, detección de intrusiones en 
#              malla air-gapped y registro cifrado de eventos críticos.
# ==============================================================================

LOG_DIR="./var/logs"
AUDIT_LOG="$LOG_DIR/network_audit.log"
mkdir -p "$LOG_DIR"

timestamp() {
    date "+%Y-%m-%d %H:%M:%S"
}

scan_interfaces() {
    echo "===================================================================="
    echo " [CHRONO-SENTINEL] Auditoría de Interfaces de Red y Enlaces Tácticos"
    echo "===================================================================="
    if command -v ip >/dev/null 2>&1; then
        ip -o addr show | awk '{print "[NET] Interface: " $2 " | IP: " $4}'
    else
        ifconfig -a 2>/dev/null || echo "[!] Comando ip/ifconfig no disponible en este entorno."
    fi
}

check_mesh_nodes() {
    echo ""
    echo "[*] Verificando nodos activos en la red en malla local..."
    if [ -f "./web_panel/nodes/active_nodes.md" ]; then
        cat "./web_panel/nodes/active_nodes.md"
    else
        echo "[INFO] No hay nodos externos registrados en el caché de malla actual."
    fi
}

run_audit() {
    echo "[*] [$(timestamp)] Iniciando escaneo de seguridad de interfaces..." >> "$AUDIT_LOG"
    scan_interfaces
    check_mesh_nodes
    echo "[✓] Auditoría de sentinel completada y registrada de forma segura."
}

case "$1" in
    "scan")
        scan_interfaces
        ;;
    "mesh")
        check_mesh_nodes
        ;;
    "audit"|"")
        run_audit
        ;;
    *)
        echo "Uso: chrono-sentinel [scan|mesh|audit]"
        ;;
es.

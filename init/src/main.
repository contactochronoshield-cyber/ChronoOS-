#define _POSIX_C_SOURCE 200809L

#include <errno.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

#include "logger.h"

#define CHRONO_VERSION "1.1.0-alpha"
#define SERVICE_PATH "./services/chronod/chronod"

#define MAX_RESTARTS 3
#define RESTART_DELAY 1

static volatile sig_atomic_t shutdown_requested = 0;
static pid_t service_pid = -1;

static void console_log(const char *level, const char *message)
{
    time_t now = time(NULL);
    struct tm tm_now;
    char timestamp[32];

    localtime_r(&now, &tm_now);

    strftime(
        timestamp,
        sizeof(timestamp),
        "%H:%M:%S",
        &tm_now
    );

    printf(
        "[%s] [%s] %s\n",
        timestamp,
        level,
        message
    );

    fflush(stdout);

    chrono_log(level, "INIT", message);
}

static void handle_signal(int signal)
{
    if (signal == SIGINT || signal == SIGTERM)
        shutdown_requested = 1;
}

static int install_signals(void)
{
    struct sigaction action;

    memset(&action, 0, sizeof(action));

    action.sa_handler = handle_signal;

    sigemptyset(&action.sa_mask);

    if (sigaction(SIGINT, &action, NULL) < 0)
        return -1;

    if (sigaction(SIGTERM, &action, NULL) < 0)
        return -1;

    return 0;
}

static pid_t start_service(const char *path)
{
    pid_t pid = fork();

    if (pid < 0) {
        perror("[INIT] fork");
        chrono_log(
            "ERROR",
            "INIT",
            "fork() failed while starting service"
        );
        return -1;
    }

    if (pid == 0) {

        execl(
            path,
            path,
            (char *)NULL
        );

        perror("[INIT] exec");

        _exit(127);
    }

    service_pid = pid;

    printf(
        "[INIT] Service started: %s (PID %ld)\n",
        path,
        (long)pid
    );

    fflush(stdout);

    chrono_log(
        "INFO",
        "INIT",
        "ChronoD process started"
    );

    return pid;
}

static void stop_service(void)
{
    if (service_pid <= 0)
        return;

    console_log(
        "INIT",
        "Stopping ChronoD..."
    );

    if (kill(service_pid, SIGTERM) < 0) {

        if (errno != ESRCH)
            perror("[INIT] kill");
    }

    waitpid(
        service_pid,
        NULL,
        0
    );

    service_pid = -1;

    console_log(
        "OK",
        "ChronoD stopped"
    );
}

static int supervise_service(void)
{
    int restart_count = 0;

    while (!shutdown_requested) {

        console_log(
            "INIT",
            "Starting service supervisor"
        );

        pid_t pid = start_service(
            SERVICE_PATH
        );

        if (pid < 0)
            return 1;

        console_log(
            "OK",
            "Service state: RUNNING"
        );

        int status = 0;

        while (!shutdown_requested) {

            pid_t result = waitpid(
                pid,
                &status,
                0
            );

            if (result == pid)
                break;

            if (result < 0 && errno == EINTR)
                continue;

            if (result < 0) {

                perror("[INIT] waitpid");

                chrono_log(
                    "ERROR",
                    "INIT",
                    "waitpid() failed"
                );

                break;
            }
        }

        if (shutdown_requested) {

            stop_service();

            break;
        }

        service_pid = -1;

        if (WIFEXITED(status)) {

            char message[128];

            snprintf(
                message,
                sizeof(message),
                "ChronoD exited with code %d",
                WEXITSTATUS(status)
            );

            console_log(
                "WARN",
                message
            );

        } else if (WIFSIGNALED(status)) {

            char message[128];

            snprintf(
                message,
                sizeof(message),
                "ChronoD terminated by signal %d",
                WTERMSIG(status)
            );

            console_log(
                "WARN",
                message
            );
        }

        restart_count++;

        if (restart_count > MAX_RESTARTS) {

            console_log(
                "ERROR",
                "ChronoD restart limit exceeded"
            );

            return 1;
        }

        console_log(
            "WARN",
            "Restarting ChronoD"
        );

        sleep(RESTART_DELAY);
    }

    return 0;
}

int main(void)
{
    printf("\n");
    printf("==============================================\n");
    printf("        ChronoOS Init %s\n", CHRONO_VERSION);
    printf("==============================================\n\n");

    printf(
        "[INIT] Development mode: PID %ld\n",
        (long)getpid()
    );

    chrono_log(
        "INFO",
        "INIT",
        "ChronoOS init started"
    );

    if (install_signals() < 0) {

        perror("[INIT] signal setup");

        chrono_log(
            "ERROR",
            "INIT",
            "Signal initialization failed"
        );

        return 1;
    }

    console_log(
        "INIT",
        "Initializing runtime"
    );

    console_log(
        "OK",
        "Runtime initialized"
    );

    console_log(
        "INIT",
        "Starting ChronoOS service supervisor"
    );

    int result = supervise_service();

    if (result == 0) {

        console_log(
            "OK",
            "ChronoOS shutdown complete"
        );

    } else {

        console_log(
            "ERROR",
            "ChronoOS stopped because of service failure"
        );
    }

    return result;
}

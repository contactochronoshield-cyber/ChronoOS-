# ChronoOS Minimalist Kernel Configuration Profile
CONFIG_DEFAULT_HOSTNAME="chronoos"
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- Optimizaciones de Seguridad y Auditoría de Ring 0 ---
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKHEADERS=y

# --- Soporte de Criptografía de Bajo Nivel y Hashes ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_AES=y

# --- Gestión de Memoria y Rendimiento en Enclaves ---
CONFIG_HIGHMEM=y
CONFIG_BINFMT_ELF=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

sub_network() {
    echo -e "${MAGENTA}=== CHRONO SOVEREIGN NETWORK & MESH STACK ===${NC}"
    echo " [1] Diagnóstico de Sockets Activos (ss/netstat)"
    echo " [2] Inicializar ID de Nodo Mesh Off-Grid"
    echo " [3] Escaneo de Perímetro Local (Nmap Hardened)"
    echo " [0] Volver"
    read -p "mesh> " net_opt
    case "$net_opt" in
        1) ss -tuln ;;
        2)
            echo -e "${GREEN}[*] Inicializando interfaz virtual mesh de Chrono Shield...${NC}"
            echo "ChronoNode-$(hostname)-$(date +%s)" > "$NETWORK_PROFILE/node_id.dat"
            cat "$NETWORK_PROFILE/node_id.dat"
            ;;
        3)
            read -p "Introduce IP objetivo o localhost: " target
            if [[ "$target" =~ ^[a-zA-Z0-9.-]+$ ]]; then
                nmap -sV -T4 "$target"
            else
                echo -e "${RED}[!] Objetivo inválido.${NC}"
            fi
            ;;
    esac
    read -p "Presiona Enter para continuar..."
}


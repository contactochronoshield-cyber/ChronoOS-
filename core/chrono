fi

log_event() {
    local level="$1"
    local message="$2"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [CHRONO-$level] $message" >> "$LOG_FILE"
    chmod 600 "$LOG_FILE" 2>/dev/null || true
}

error_handler() {
    local exit_code=$?
    log_event "ERROR" "Falla en línea $1 (Exit Code: $exit_code)"
}
trap 'error_handler $LINENO' ERR

boot_animation() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║         CHRONOOS SOVEREIGN ENTERPRISE KERNEL v7.0.0 (TITANIUM)     ║${NC}"
    echo -e "${CYAN}║         Chrono Shield Networks | Zero-Telemetry Mesh Core          ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════════════╝${NC}"
    echo -e "${BLUE} > Authors: Daniel Gonzales Martínez, Adrián & Chrono Shield Team ${NC}"
    echo -e "${BLUE} > Base: Bogotá -> Global Deployment ${NC}"
    echo -e "${GRAY} Loading kernel modules & zero-telemetry daemon... [ OK ]"
    echo -e " Initializing AES-256-CBC cryptographic vault...   [ OK ]"
    echo -e " Mounting sovereign userland & mesh sockets...       [ OK ]${NC}"
    sleep 0.8
}

sub_vault() {
    echo -e "${CYAN}=== CHRONO SECURE VAULT (AES-256-CBC + SHA-256) ===${NC}"
    echo " [1] Cifrar archivo o directorio con firma inmutable"
    echo " [2] Descifrar elemento de la bóveda"
    echo " [3] Listar elementos protegidos y verificar integridad"
    echo " [0] Volver"
    read -p "vault> " v_opt
    case "$v_opt" in
        1)
            read -p "Ruta del recurso a blindar: " target
            if [ -e "$target" ]; then
                local name
                name=$(basename "$target")
                if [ -d "$target" ]; then
                    tar -czf "$CHRONO_HOME/$name.tar.gz" "$target"
                    openssl enc -aes-256-cbc -salt -pbkdf2 -in "$CHRONO_HOME/$name.tar.gz" -out "$VAULT_DIR/$name.tar.gz.enc"
                    rm -f "$CHRONO_HOME/$name.tar.gz"
                else
                    openssl enc -aes-256-cbc -salt -pbkdf2 -in "$target" -out "$VAULT_DIR/$name.enc"
                fi
                sha256sum "$VAULT_DIR/"* > "$VAULT_DIR/integrity.sha256"
                chmod 600 "$VAULT_DIR"/* 2>/dev/null || true
                echo -e "${GREEN}[✔] Recurso cifrado y firmado criptográficamente en $VAULT_DIR${NC}"
                log_event "SUCCESS" "Cifrado exitoso de $name"
            else
                echo -e "${RED}[!] La ruta no existe.${NC}"
            fi
            ;;
        2)
            ls -1 "$VAULT_DIR"
            read -p "Nombre del archivo cifrado en bóveda: " enc_file
            if [ -f "$VAULT_DIR/$enc_file" ]; then
                local out_name
                out_name=$(echo "$enc_file" | sed 's/\.enc$//')
                openssl enc -d -aes-256-cbc -pbkdf2 -in "$VAULT_DIR/$enc_file" -out "$CHRONO_HOME/$out_name"
                if [[ "$out_name" == *.tar.gz ]]; then
                    tar -xzf "$CHRONO_HOME/$out_name" -C "$CHRONO_HOME/"
                    rm -f "$CHRONO_HOME/$out_name"
                fi
                echo -e "${GREEN}[✔] Recurso restaurado en $CHRONO_HOME${NC}"
                log_event "SUCCESS" "Descifrado exitoso de $enc_file"
            else
                echo -e "${RED}[!] Archivo no encontrado en la bóveda.${NC}"
            fi
            ;;
        3)
            echo -e "${MAGENTA}--- Elementos en Bóveda & Verificación SHA-256 ---${NC}"
            ls -lh "$VAULT_DIR"
            if [ -f "$VAULT_DIR/integrity.sha256" ]; then
                echo ""
                sha256sum -c "$VAULT_DIR/integrity.sha256" 2>/dev/null || echo "Verificación completada."
            fi
            ;;
    esac
    read -p "Presiona Enter para continuar..."
}


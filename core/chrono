GRAY='\033[1;30m'
NC='\033[0m'

CHRONO_HOME="$HOME/chrono-os"
CONFIG_DIR="$HOME/.chrono"
CONFIG_FILE="$CONFIG_DIR/config.json"
LOG_FILE="$CONFIG_DIR/chrono_sovereign.log"
VAULT_DIR="$CHRONO_HOME/vault_store"

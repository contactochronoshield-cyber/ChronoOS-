sub_docker_mgr() {
    echo -e "${BLUE}=== CHRONO CONTAINER DEPLOYER (Zero-Telemetry) ===${NC}"
    echo " [1] Listar contenedores activos (Docker / Podman)"
    echo " [2] Desplegar nodo web soberano de prueba (Nginx ligero)"
    echo " [0] Volver"
    read -p "container> " c_opt
    case "$c_opt" in
        1)
            if command -v docker >/dev/null 2>&1; then
                docker ps -a
            else
                echo -e "${RED}[!] Docker no detectado en este entorno userland.${NC}"
            fi
            ;;
        2)
            if command -v docker >/dev/null 2>&1; then
                docker run -d --name chrono-web-node -p 8080:80 nginx:alpine || true
                echo -e "${GREEN}[✔] Nodo web corporativo desplegado en puerto 8080.${NC}"
            else
                echo -e "${RED}[!] Motor de contenedores no disponible.${NC}"
            fi
            ;;
    esac
    read -p "Presiona Enter para continuar..."
}

sub_keys() {
    echo -e "${MAGENTA}=== CHRONO KEY (Generador de Identidades SSH/Ed25519) ===${NC}"
    read -p "Introduce tu email corporativo o personal para la llave: " user_mail
    if [ -n "$user_mail" ]; then
        local key_name="$KEYS_DIR/chrono_ed25519"
        ssh-keygen -t ed25519 -C "$user_mail [Chrono Shield Networks]" -f "$key_name" -N ""
        echo -e "${GREEN}[✔] Par de llaves criptográficas generado en $KEYS_DIR${NC}"
        cat "$key_name.pub"
        log_event "SUCCESS" "Generación de llaves Ed25519 para $user_mail"
    else
        echo -e "${RED}[!] Email requerido.${NC}"
    fi
    read -p "Presiona Enter para continuar..."
}


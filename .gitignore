# Compiled binaries
*.o
*.a
*.so

# Local build artifacts
/build/
*.img.tmp

# Test binaries
init/test-registry
init/test-service-config

# Backups
*.backup
*.before_logger_fix
*.bak

# Runtime logs
var/logs/*.log
var/logs/*.csv

# Private keys and secrets
*.pem
*.key
*.pub

# Local security/auth material
security/auth/*

# Termux/editor temporary files
*~
sentinel/sovereign/state/security-state

# ChronoOS Sentinel runtime state and generated forensic output
sentinel/sovereign/forensics/*.log
sentinel/sovereign/state/threat-state
sentinel/sovereign/state/behavior-state

# ChronoOS Sentinel runtime state
sentinel/sovereign/state/*
!sentinel/sovereign/state/.gitkeep

# ChronoOS Sentinel forensic runtime output
sentinel/sovereign/forensics/*.log

# ChronoOS Sentinel generated threat runtime
sentinel/sovereign/threats/runtime/
sentinel/sovereign/threats/*.log

# Compiled binaries
*.o
*.a
*.so

# Local build artifacts
/build/
*.img.tmp

# Test binaries
init/test-registry
init/test-service-config

# Backups
*.backup
*.before_logger_fix
*.bak

# Runtime logs
var/logs/*.log
var/logs/*.csv

# Private keys and secrets
*.pem
*.key
*.pub

# Local security/auth material
security/auth/*

# Termux/editor temporary files
*~
sentinel/sovereign/state/security-state

# ChronoOS Sentinel runtime state and generated forensic output
sentinel/sovereign/forensics/*.log
sentinel/sovereign/state/threat-state
sentinel/sovereign/state/behavior-state

# ChronoOS Sentinel runtime state
sentinel/sovereign/state/*
!sentinel/sovereign/state/.gitkeep

# ChronoOS Sentinel forensic runtime output
sentinel/sovereign/forensics/*.log

# ChronoOS Sentinel generated threat runtime
sentinel/sovereign/threats/runtime/
sentinel/sovereign/threats/*.log

# ChronoOS Sentinel generated attribution state
sentinel/sovereign/state/attribution-state

# ChronoOS Sentinel generated attribution reports
sentinel/sovereign/reports/attribution/*.txt

# ChronoOS Sentinel evidence - NEVER commit incident evidence
sentinel/sovereign/evidence/acquisition/*
sentinel/sovereign/evidence/hashes/*
sentinel/sovereign/evidence/manifests/*
sentinel/sovereign/evidence/chain-of-custody/*

# Chrono Telecom Threat Observatory runtime
sentinel/sovereign/reports/telecom/*
sentinel/sovereign/state/telecom-threat-state
